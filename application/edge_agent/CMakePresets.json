{
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ],
  "configurePresets": [
    {
      "environment": {
        "PYTHONUTF8": "1",
        "IDF_TARGET": "esp32s3"
      },
      "cacheVariables": {
        "CCACHE_ENABLE": "0",
        "SDKCONFIG": "${sourceDir}/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults;${sourceDir}/components/gen_bmgr_codes/board_manager.defaults;${sourceDir}/sdkconfig.defaults.keyboard"
      },
      "binaryDir": "${sourceDir}/../../build/keyboard",
      "displayName": "ESP-Claw ESP32-S3 N16R8",
      "name": "default",
      "generator": "Ninja"
    }
  ],
  "cmakeMinimumRequired": {
    "patch": 0,
    "minor": 21,
    "major": 3
  },
  "version": 3
}
