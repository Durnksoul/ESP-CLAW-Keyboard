{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (development)",
      "description": "Development configuration",
      "binaryDir": "${fileDir}/build/keyboard",
      "cacheVariables": {
        "CCACHE_ENABLE": "0",
        "SDKCONFIG": "${fileDir}/application/edge_agent/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${fileDir}/application/edge_agent/sdkconfig.defaults;${fileDir}/application/edge_agent/components/gen_bmgr_codes/board_manager.defaults;${fileDir}/application/edge_agent/sdkconfig.defaults.keyboard"
      },
      "generator": "Ninja",
      "environment": {
        "PYTHONUTF8": "1",
        "IDF_TARGET": "esp32s3"
      }
    },
    {
      "name": "production",
      "displayName": "Production",
      "description": "Production configuration",
      "binaryDir": "${fileDir}/build/production",
      "cacheVariables": {
        "CCACHE_ENABLE": "0",
        "SDKCONFIG": "${fileDir}/application/edge_agent/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${fileDir}/application/edge_agent/sdkconfig.defaults;${fileDir}/application/edge_agent/components/gen_bmgr_codes/board_manager.defaults;${fileDir}/application/edge_agent/sdkconfig.defaults.keyboard"
      },
      "generator": "Ninja",
      "environment": {
        "PYTHONUTF8": "1",
        "IDF_TARGET": "esp32s3"
      }
    }
  ]
}
